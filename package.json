{
  "name": "vscode-bookmarks-plus",
  "displayName": "Bookmarks Plus",
  "description": "Bookmark files and folders (not just lines) in a workspace, with collections and git-repo awareness.",
  "version": "1.1.0",
  "publisher": "cbeaulieu-gt",
  "repository": {
    "type": "git",
    "url": "https://github.com/glitchwerks/vscode-bookmarks-plus.git"
  },
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "icon": "images/icon.png",
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "bookmarksActivityBar", "title": "Bookmarks Plus", "icon": "$(bookmark)" }
      ]
    },
    "views": {
      "bookmarksActivityBar": [
        { "id": "bookmarksView", "name": "Bookmarks", "icon": "$(bookmark)" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bookmarksView",
        "contents": "No bookmarks yet — right-click a file or folder to add one."
      }
    ],
    "commands": [
      { "command": "bookmarks.addFile", "title": "Add Bookmark", "category": "Bookmarks Plus" },
      { "command": "bookmarks.addFolder", "title": "Add Bookmark", "category": "Bookmarks Plus" },
      { "command": "bookmarks.addFileGlobal", "title": "Add Bookmark (Global)", "category": "Bookmarks Plus" },
      { "command": "bookmarks.addFolderGlobal", "title": "Add Bookmark (Global)", "category": "Bookmarks Plus" },
      { "command": "bookmarks.remove", "title": "Remove Bookmark", "category": "Bookmarks Plus", "icon": "$(trash)" },
      { "command": "bookmarks.reveal", "title": "Reveal in Explorer", "category": "Bookmarks Plus", "icon": "$(go-to-file)" },
      { "command": "bookmarks.newCollection", "title": "New Collection", "category": "Bookmarks Plus", "icon": "$(new-folder)" },
      { "command": "bookmarks.newGlobalCollection", "title": "New Collection", "category": "Bookmarks Plus", "icon": "$(new-folder)" },
      { "command": "bookmarks.renameCollection", "title": "Rename Collection", "category": "Bookmarks Plus", "icon": "$(edit)" },
      { "command": "bookmarks.setDescription", "title": "Set Description", "category": "Bookmarks Plus", "icon": "$(note)" },
      { "command": "bookmarks.deleteCollection", "title": "Delete Collection", "category": "Bookmarks Plus", "icon": "$(trash)" },
      { "command": "bookmarks.moveToCollection", "title": "Move to Collection", "category": "Bookmarks Plus", "icon": "$(folder-opened)" },
      { "command": "bookmarks.addToWorkspace", "title": "Add to Workspace", "category": "Bookmarks Plus", "icon": "$(root-folder)" },
      { "command": "bookmarks.toggleGroupByRepo", "title": "Toggle Group by Repo", "category": "Bookmarks Plus", "icon": "$(repo)" },
      { "command": "bookmarks.refresh", "title": "Refresh", "category": "Bookmarks Plus", "icon": "$(refresh)" },
      { "command": "bookmarks.promoteSuggestion", "title": "Add Bookmark from Suggestion", "category": "Bookmarks Plus", "icon": "$(add)" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "bookmarks.addFile", "when": "!explorerResourceIsFolder", "group": "bookmarksPlus" },
        { "command": "bookmarks.addFolder", "when": "explorerResourceIsFolder", "group": "bookmarksPlus" },
        { "command": "bookmarks.addFileGlobal", "when": "!explorerResourceIsFolder", "group": "bookmarksPlus" },
        { "command": "bookmarks.addFolderGlobal", "when": "explorerResourceIsFolder", "group": "bookmarksPlus" }
      ],
      "view/title": [
        { "command": "bookmarks.newCollection", "when": "view == bookmarksView", "group": "navigation@1" },
        { "command": "bookmarks.toggleGroupByRepo", "when": "view == bookmarksView", "group": "navigation@2" },
        { "command": "bookmarks.refresh", "when": "view == bookmarksView", "group": "navigation@3" }
      ],
      "view/item/context": [
        { "command": "bookmarks.remove", "when": "view == bookmarksView && viewItem =~ /^bookmarkItem\\b/", "group": "inline@1" },
        { "command": "bookmarks.reveal", "when": "view == bookmarksView && viewItem =~ /^bookmarkItem\\b/", "group": "inline@2" },
        { "command": "bookmarks.moveToCollection", "when": "view == bookmarksView && viewItem =~ /^bookmarkItem\\b/", "group": "inline@3" },
        { "command": "bookmarks.renameCollection", "when": "view == bookmarksView && viewItem == bookmarkCollection", "group": "inline@1" },
        { "command": "bookmarks.deleteCollection", "when": "view == bookmarksView && viewItem == bookmarkCollection", "group": "inline@2" },
        { "command": "bookmarks.setDescription", "when": "view == bookmarksView && viewItem =~ /^bookmarkItem\\b/", "group": "bookmarks@1" },
        { "command": "bookmarks.setDescription", "when": "view == bookmarksView && viewItem == bookmarkCollection", "group": "bookmarks@1" },
        { "command": "bookmarks.addToWorkspace", "when": "view == bookmarksView && viewItem == bookmarkItem-addable", "group": "inline@4" },
        { "command": "bookmarks.newGlobalCollection", "when": "view == bookmarksView && viewItem == bookmarkGlobalRoot", "group": "inline@1" },
        { "command": "bookmarks.promoteSuggestion", "when": "view == bookmarksView && viewItem == bookmarkSuggestion", "group": "inline@1" }
      ],
      "commandPalette": [
        { "command": "bookmarks.addFile", "when": "false" },
        { "command": "bookmarks.addFolder", "when": "false" },
        { "command": "bookmarks.addFileGlobal", "when": "false" },
        { "command": "bookmarks.addFolderGlobal", "when": "false" },
        { "command": "bookmarks.addToWorkspace", "when": "false" },
        { "command": "bookmarks.newGlobalCollection", "when": "false" },
        { "command": "bookmarks.promoteSuggestion", "when": "false" }
      ]
    },
    "jsonValidation": [
      { "fileMatch": ".vscode/bookmarks.json", "url": "./schemas/bookmarks.schema.json" }
    ],
    "configuration": {
      "title": "Bookmarks Plus",
      "properties": {
        "bookmarksPlus.explorerDecoration.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show a badge and tooltip in the Explorer on files and folders that are bookmarked."
        },
        "bookmarksPlus.suggestions.maxItems": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "scope": "window",
          "description": "Maximum number of suggested bookmarks (recently opened items) to show in the Suggested section. Set to 0 to disable the section entirely."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "vsce:package": "vsce package --no-dependencies",
    "publish:stable": "node scripts/guard-channel.js stable && vsce publish",
    "publish:prerelease": "node scripts/guard-channel.js prerelease && vsce publish --pre-release"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.24.0",
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "@types/mocha": "^10.0.6",
    "typescript": "^5.4.0",
    "esbuild": "^0.20.0",
    "mocha": "^10.3.0",
    "glob": "^10.3.10",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0"
  }
}
