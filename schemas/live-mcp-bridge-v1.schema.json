{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmarks-plus.dev/schemas/live-mcp-bridge-v1.schema.json",
  "title": "Bookmarks Plus live MCP bridge v1 message",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/ready" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "protocolVersion": { "const": 1 },
    "scope": { "enum": ["workspace", "global"] },
    "startupCode": {
      "enum": [
        "bootstrap-expired",
        "bootstrap-consumed",
        "producer-restarted",
        "workspace-folder-unavailable",
        "scope-unavailable",
        "bridge-unavailable"
      ]
    },
    "operationCode": {
      "enum": [
        "invalid-request",
        "invalid-session",
        "scope-unavailable",
        "workspace-folder-unavailable",
        "collection-not-found",
        "duplicate-bookmark",
        "bookmark-outside-root",
        "payload-too-large",
        "store-unavailable",
        "internal-error"
      ]
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "generation", "token"],
      "properties": {
        "kind": { "const": "hello" },
        "version": { "$ref": "#/$defs/protocolVersion" },
        "generation": { "type": "string" },
        "token": { "type": "string" }
      }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "sessionId", "workspaceFolderUri", "grantedScopes"],
      "properties": {
        "kind": { "const": "ready" },
        "version": { "$ref": "#/$defs/protocolVersion" },
        "sessionId": { "type": "string" },
        "workspaceFolderUri": { "type": "string" },
        "grantedScopes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scope" }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "sessionId", "workspaceFolderUri", "method", "params"],
      "properties": {
        "kind": { "const": "request" },
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "workspaceFolderUri": { "type": "string" },
        "method": { "enum": ["list", "add"] },
        "params": { "type": "object" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "const": "response" },
        "id": { "type": "string" },
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "anyOf": [{ "$ref": "#/$defs/startupCode" }, { "$ref": "#/$defs/operationCode" }] },
            "message": { "type": "string" }
          }
        }
      },
      "oneOf": [
        { "required": ["result"], "not": { "required": ["error"] } },
        { "required": ["error"], "not": { "required": ["result"] } }
      ]
    }
  }
}
